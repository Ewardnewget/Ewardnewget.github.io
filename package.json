{
  "name": "shihao-zhu-academic-homepage",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Shihao Zhu's research homepage on the existing HugoBlox stack",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify && python3 scripts/check_site.py public",
    "test:content": "python3 -m unittest discover -s tests -p test_content.py -v",
    "test:site": "python3 scripts/check_site.py public",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
